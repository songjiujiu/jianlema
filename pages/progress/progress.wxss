.progress-head {
  padding-bottom: 122rpx;
}

.progress-head .tag {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.calendar-card,
.trend-card {
  padding: 28rpx;
  border: 2rpx solid #e0e7e1;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(13, 27, 30, 0.07);
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-btn {
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  border: 2rpx solid #d7e0d9;
  border-radius: 8rpx;
  background: #f8faf7;
  color: #162022;
  font-size: 44rpx;
  line-height: 72rpx;
}

.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
}

.weekday {
  height: 42rpx;
  color: #7a8682;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.calendar-day {
  position: relative;
  height: 86rpx;
  border: 2rpx solid #e0e7e1;
  border-radius: 8rpx;
  background: #f8faf7;
  color: #162022;
  font-size: 24rpx;
  line-height: 34rpx;
  padding-top: 12rpx;
  text-align: center;
}

.calendar-day.muted-day {
  opacity: 0.34;
}

.calendar-day.today {
  border-color: #1f4e5f;
}

.calendar-day.checked {
  border-color: #96cbbb;
  background: #e8f5f1;
  color: #0f7c66;
  font-weight: 900;
}

.calendar-day.missed {
  border-color: #ffc1b2;
  background: #ffece6;
  color: #d45d49;
}

.day-status {
  display: block;
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 900;
}

.trend {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 188rpx;
  margin-top: 22rpx;
  padding: 18rpx 8rpx 0;
  overflow-x: auto;
}

.trend-item {
  flex: 0 0 54rpx;
  text-align: center;
}

.trend-bar-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 118rpx;
}

.trend-bar {
  width: 32rpx;
  min-height: 20rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #1f4e5f;
}

.trend-weight {
  display: block;
  margin-top: 10rpx;
  color: #6f7d79;
  font-size: 20rpx;
  font-weight: 700;
}

.compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.compare-image {
  width: 100%;
  height: 420rpx;
  border-radius: 8rpx;
  background: #e0e7e1;
}

.photo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.photo-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx;
  border: 2rpx solid #e0e7e1;
  border-radius: 8rpx;
  background: #ffffff;
}

.photo-item.selected {
  border-color: #1f4e5f;
  background: #edf7f4;
}

.photo-thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 8rpx;
  background: #e0e7e1;
}

.photo-meta {
  flex: 1;
  min-width: 0;
}

.photo-date {
  display: block;
  margin-bottom: 10rpx;
  color: #162022;
  font-size: 30rpx;
  font-weight: 900;
}

.delete-btn {
  width: 94rpx;
  height: 58rpx;
  padding: 0;
  border: 2rpx solid #ffc1b2;
  border-radius: 8rpx;
  background: #ffece6;
  color: #d45d49;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 54rpx;
}
